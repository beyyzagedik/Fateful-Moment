{
  "expo": {
    "name": "Fateful Moment",
    "slug": "fateful-moment",
    "scheme": "fatefulmoment",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon-fateful.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050A1C",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.fatefulmoment.app"
    },
    "android": {
      "package": "com.fatefulmoment.app",
      "adaptiveIcon": {
        "backgroundColor": "#050A1C",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-video",
      "expo-font",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#02020A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
